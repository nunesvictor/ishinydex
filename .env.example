# Copie para .env e troque todos os valores `change-me` antes de subir.

## banco (serviço `db`)
POSTGRES_DB=ishinydex
POSTGRES_USER=postgres
# gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

## backend (Django)
# gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS="*"
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
# gere uma senha forte
DJANGO_SUPERUSER_PASSWORD=change-me
# origens liberadas no CORS (só se o app for servido de outro endereço)
FRONTEND_ORIGINS="http://localhost:8090"

## acesso
# porta do app no host (app, /api, /admin, /media)
X_WEB_PORT=8090

## frontend (vale no próximo `docker compose up -d --build`)
# true: compila também em WebAssembly, que deixa o app bem mais fluido nos
# navegadores Chromium (Chrome, Brave, Edge); Safari e Firefox continuam no
# build JavaScript, gerado junto. false: só JavaScript, se o wasm der problema.
X_WEB_WASM=true
# Versão mostrada em Ajustes. Não precisa definir aqui: o comando de
# atualização do README a preenche com a tag (`git describe --tags`).
# X_APP_VERSION=v1.0.0
